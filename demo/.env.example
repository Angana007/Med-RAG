# Med-RAG Demo Console — environment variables
# All variables are OPTIONAL. With none set, the app runs in DEMO mode:
# retrieval is fully live; showcase answers are pre-verified against sources.

# ── Live generation (optional) ─────────────────────────────────────────────
# Point at a running Ollama server to switch every query to real Phi-3
# generation. Locally this is usually:
#   OLLAMA_URL=http://localhost:11434
# From inside Docker on the same machine:
#   OLLAMA_URL=http://host.docker.internal:11434
# Via your Cloudflare Tunnel (keeps inference on your machine):
#   OLLAMA_URL=https://your-tunnel-subdomain.trycloudflare.com
OLLAMA_URL=

# Model name as pulled in Ollama (default: phi3)
OLLAMA_MODEL=phi3

# ── Secrets policy ──────────────────────────────────────────────────────────
# The demo needs NO API keys and contains NO real patient data — everything
# in demo_corpus.json is synthetic. If you expose a live OLLAMA_URL publicly,
# put it behind Cloudflare Access or an auth proxy; never commit real
# endpoints or keys to git. (.env is gitignored.)
